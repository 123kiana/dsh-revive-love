{
  "name": "dsh-revive-love",
  "version": "1.4.1",
  "description": "Unofficial third-party DSH plugin: revive an over-long DeepSeek chat export by importing only its most recent turns.",
  "keywords": [
    "context",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "harness",
    "import",
    "revive",
    "session"
  ],
  "homepage": "https://github.com/123kiana/dsh-revive-love#readme",
  "bugs": {
    "url": "https://github.com/123kiana/dsh-revive-love/issues"
  },
  "license": "MIT",
  "author": "123kiana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/123kiana/dsh-revive-love.git"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "amplify.js",
    "summary-prompt.js",
    "history-tool.js",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/*.md",
    "icon.svg",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check amplify.js && node --check summary-prompt.js && node --check history-tool.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
